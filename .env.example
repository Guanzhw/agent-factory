# Server settings for local account login. See docs/WINDOWS_LOCAL_START.md for HTTPS setup.
FACTORY_DATABASE_URL=postgresql+psycopg://factory_user@127.0.0.1:5432/factory
FACTORY_PORT=3100
FACTORY_MAX_WORKERS=2

# Supply the persistent signing key through your deployment's secret configuration.
# The first-run "agent-factory local" wizard can generate and reuse a local key.
# FACTORY_JWT_KEY=

# Default origin is https://127.0.0.1:<FACTORY_PORT>. Set the exact HTTPS origin for a team site.
# FACTORY_LOCAL_LOGIN_ORIGIN=https://factory.example.org
# Preserve the database, the original signing key and the workspace containing runtime/credential-vault.key.
