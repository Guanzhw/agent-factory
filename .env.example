FACTORY_MODE=demo
# Configure an operator-owned PostgreSQL database; never commit real credentials.
FACTORY_DATABASE_URL=postgresql+psycopg://factory_demo@127.0.0.1:65431/factory_demo
FACTORY_MAX_WORKERS=2
FACTORY_PORT=3100
# Production requires an explicitly configured private JWT key and clean database.
# FACTORY_JWT_KEY=

# Configurable plan review; production default is admin-review, demo is bounded-synthetic.
# Read-only-auto permits known read-only scopes; experiments still need plan review and native HITL.
# FACTORY_TEMPORARY_POLICY=admin-review
# FACTORY_POLICY_REVISION=plan-policy-v1
# FACTORY_PLAN_REVIEW_TTL_SECONDS=3600
