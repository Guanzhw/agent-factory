FACTORY_MODE=demo
# Configure an operator-owned PostgreSQL database; never commit real credentials.
FACTORY_DATABASE_URL=postgresql+psycopg://factory_demo@127.0.0.1:65431/factory_demo
FACTORY_MAX_WORKERS=2
FACTORY_PORT=3100
# Production requires a private JWT key and existing member accounts.
# FACTORY_JWT_KEY=

# Members execute plans and publish their own materials/applications directly.
FACTORY_TEMPORARY_POLICY=member-self-service
FACTORY_POLICY_REVISION=department-member-v1
FACTORY_MATERIAL_REVIEW_MODE=member-self-service
FACTORY_MATERIAL_POLICY_REVISION=material-department-v1

# Migration: replace retired approval modes and remove plan-review TTL settings.
# Keep existing PostgreSQL records and the paired runtime/credential-vault.key.
