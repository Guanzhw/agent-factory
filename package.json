{
  "name": "agent-factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "uv run agent-factory",
    "dev:web": "vite --host 127.0.0.1",
    "start": "uv run agent-factory",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web shared *.ts *.js",
    "check": "npm run lint && npm run typecheck && npm run build",
    "start:configured": "uv run agent-factory",
    "check:python": "uv run ruff check platform deployment applications && uv run pyright",
    "build:research": "npm run build",
    "dev:research": "npm run dev:web"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tabler/icons-react": "3.49.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "10.11.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.7"
  }
}
