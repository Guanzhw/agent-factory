    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "10.11.0",
    "supertest": "7.1.4",
    "tsx": "4.22.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
