{
  "name": "agent-factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "uv run python scripts/dev.py",
    "dev:web": "vite --host 127.0.0.1",
    "start": "uv run python scripts/dev.py",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web shared tests *.ts *.js",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start:configured": "uv run agent-factory",
    "check:python": "uv run ruff check platform scripts && uv run pyright && uv run python -m unittest discover -s platform/tests -v"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "10.11.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
